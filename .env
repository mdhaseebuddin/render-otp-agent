# =================================================================
# VeloTest Render Real-Time OTP Webhook Receiver Configuration
# Official Google Gmail REST API over HTTPS (Port 443)
# =================================================================

# 1. Google OAuth2 Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# 2. Sender Email (Default: velotest2026@gmail.com)
SENDER_EMAIL=velotest2026@gmail.com

# 3. Webhook Security (Optional)
# Matches the Token set in Render Log Streams configuration (leave empty for none)
WEBHOOK_SECRET=

# 4. Application Settings
APP_NAME=VeloTest
DEDUP_CACHE_TTL=300
PORT=8000
