# =================================================================
# VeloTest Render Real-Time OTP Webhook Receiver Configuration
# =================================================================

# 1. Brevo HTTPS REST API Credentials (Port 443 - Works on Render Free Tier)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_API_KEY_FALLBACK=

# Sender Details (Must be a verified sender in Brevo)
SENDER_EMAIL=mdhaseebuddin24@gmail.com
SENDER_NAME=VeloTest Security

# 2. Webhook Security (Optional)
