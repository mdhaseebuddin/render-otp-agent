# =================================================================
# VeloTest Render Real-Time OTP Webhook Receiver Configuration
# =================================================================

# 1. Email Provider Selection: 'auto', 'brevo', or 'gmail'
# 'auto': Uses Brevo if BREVO_API_KEY is present, else Gmail SMTP
EMAIL_PROVIDER=auto

# 2. Option A: Brevo (Sendinblue) API Credentials (Recommended)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=VeloTest Verification

# 3. Option B: Gmail SMTP Credentials
EMAIL_USER=your_sender_email@gmail.com
EMAIL_PASS=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# 4. Webhook Security (Optional)
# Matches the Token set in Render Log Streams configuration (leave empty for none)
WEBHOOK_SECRET=

# 5. Application Settings
APP_NAME=VeloTest Verification
DEDUP_CACHE_TTL=300
PORT=8000

# Optional: Custom Regex override if VeloTest has a very specific custom format
# OTP_CUSTOM_REGEX=
