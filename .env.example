# =================================================================
# Render Real-Time OTP Webhook Receiver Configuration
# =================================================================

# 1. Gmail SMTP Credentials
EMAIL_USER=your_sender_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# 2. Webhook Security (Optional)
# Matches the Token set in Render Log Streams configuration (leave empty for none)
WEBHOOK_SECRET=

# 3. Application Settings
APP_NAME=Render OTP Dispatcher
DEDUP_CACHE_TTL=300
